# Copy to .env and adjust. Every value has a safe local default, so .env is optional for a demo.
DB_USER=newtonite
DB_PASSWORD=newtonite
DB_PORT=5433
API_PORT=8081
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
WEB_PORT=3000
